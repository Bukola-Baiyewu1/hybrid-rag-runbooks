# Copy to .env (never commit .env). Everything here is optional for a local run.

# Claude writes answers, judges citations, and grades the evaluation when a key is set.
# Without a key Athena runs fully offline: extractive answers + lexical citation checks.
ANTHROPIC_API_KEY=
ATHENA_GENERATION_MODEL=claude-sonnet-5-5
ATHENA_JUDGE_MODEL=claude-sonnet-5-5

# Retrieval. Strategy: fixed | headers | semantic. Reranker: cross-encoder | claude | none.
ATHENA_STRATEGY=headers
ATHENA_RERANKER=cross-encoder
ATHENA_TOP_K=5

# Answer gating ("not in the docs")
ATHENA_MIN_RELEVANCE=0.05
ATHENA_MIN_CONFIDENCE=0.5

# Storage: leave empty for in-memory; Docker Compose sets PostgreSQL + pgvector.
# DATABASE_URL=postgresql+psycopg://athena:password@localhost:5432/athena

# If set, POST /ingest requires the header X-Admin-Token with this value.
ATHENA_ADMIN_TOKEN=
